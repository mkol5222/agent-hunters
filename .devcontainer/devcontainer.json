{
	"name": "Ubuntu",
	"build": {
		"dockerfile": "Dockerfile",
		"context": ".."
	},
	"features": {
		"ghcr.io/devcontainers/features/desktop-lite:1": {}
	},
	"forwardPorts": [
		6080,
		5901,
		4601
	],
	"portsAttributes": {
		"6080": {
			"label": "noVNC (browser)"
		}, "4601": {
			"label": "opencode web (browser)"
		}

	},
	"runArgs": [
		"--shm-size=2g"
	] 
}